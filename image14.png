            </div>
          </p>
          <h5 class="project-count11"><label id="WheelPC1_ProjectCost">₹ ${numberWithCommas(data.ProjectCost)}</label></h5>
        </div>
      </div>

      <div class="col-xl-4 col-md-12 col-sm-12 d-flex text-center extrapad project-count11">
        <img src="../Content/img/revised-cost.png" alt="">
        <div class="text-center m-0" style="position:relative">
          <p class="count-head py-2 d-inline-block">
