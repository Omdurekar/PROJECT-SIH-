    <script>
        $('.sub-menu ul').hide();
        $(".sub-menu a").click(function () {
            $(this).parent(".sub-menu").children("ul").slideToggle("100");
            $(this).find(".right").toggleClass("fa-caret-up fa-caret-down");
        });

        // Hide the search box initially
        $("#searchhome,#searchmob").hide();

        // Toggle the search box on click of the search icon
        $("#homesearch,#mosearch").on("click", function () {
            $("#searchhome,#searchmob").toggle();
        });

        // Hide the search box when clicked anywhere else on the page
        $(document).on("click", function (event) {
            if (!$(event.target).closest("#homesearch, #searchhome, #searchmob, #mosearch").length) {
                $("#searchhome, #searchmob").hide();
            }
        });





    </script>


    




    


    <script>
        var swiper = new Swiper(".clientslider", {
            loop: true,
            speed: 1000,
            autoplay: true,
            spaceBetween: 20,
            slidesPerView: 4,
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            breakpoints: {
                0: {
                    slidesPerView: 1,
                    spaceBetween: 15,
                },
                468: {
                    slidesPerView: 2,
                    spaceBetween: 20,
                },
                640: {
                    slidesPerView: 3.5,
                    spaceBetween: 20,
                },
                768: {
                    slidesPerView: 6.1,
                    spaceBetween: 20,
                },
                1140: {
                    slidesPerView: 8.5,
                },
                1449: {
                    slidesPerView: 9,
                },
            },
        });
    </script>



    <script>

        function smallsize() {
            document.getElementById("pagelayout").style.fontSize = "small";
            updateActiveClass("small");
        }

        function mediumsize() {
            document.getElementById("pagelayout").style.fontSize = "medium";
            updateActiveClass("medium");
        }

        function largesize() {
            document.getElementById("pagelayout").style.fontSize = "large";
            updateActiveClass("large");
        }
    </script>





