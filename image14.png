<script>
    $(document).ready(function () {
        // Main Slider
        $('.media-main').slick({
            slidesToShow: 1,
            //autoplay:true,
            slidesToScroll: 1,
            //centerMode: true,
            //infinite: false,
            arrows: false,
            fade: true,
            asNavFor: '.media-thumb' // Link to navigation slider
        });

        // Navigation Slider
        $('.media-thumb').slick({
            slidesToShow: 4,       // Number of thumbnails to show
            //autoplay:true,
            //infinite: false,
            slidesToScroll: 1,
            asNavFor: '.media-main', // Link to main slider
            dots: false,
            //centerMode: true,       // Enable center mode
            focusOnSelect: true,     // Focus on selected thumbnail
            prevArrow: "<div class='arrowboxleft'><img src='../Content/img/arrow-left.svg' alt='Arrow Left'></div>",
            nextArrow: "<div class='arrowboxright'><img src='../Content/img/arrow-right.svg' alt='Arrow Left'></div>",
            responsive: [
                {
                    breakpoint: 767, // Below 567px
                    settings: {
                        slidesToShow: 3.2, // Show 2 thumbnails
                        slidesToScroll: 1
                    }
                },
                {
                    breakpoint: 567, // Below 567px
                    settings: {
                        slidesToShow: 2.5, // Show 2 thumbnails
                        slidesToScroll: 1
                    }
                },
                {
                    breakpoint: 0, // Default for very small screens
                    settings: {
                        slidesToShow: 2.3, // Show 1 thumbnail
                        slidesToScroll: 1
                    }
                }
            ]
        });
    });

    function smallsize() {
        document.getElementById("pagelayout").style.fontSize = "small";
        updateActiveClass("small");
    }

    function mediumsize() {
        document.getElementById("pagelayout").style.fontSize = "medium";
        updateActiveClass("medium");
    }

    function largesize() {
        document.getElementById("pagelayout").style.fontSize = "large";
        updateActiveClass("large");
    }

    function updateActiveClass(size) {
        // Remove the active class from all buttons
        document.querySelectorAll(".topsetting button").forEach((button) => {
            button.classList.remove("active");
        });

        // Add the active class to the clicked button
        document.querySelector(`button[onclick*="${size}size"]`).classList.add("active");

        // Update the body class
        const body = document.body;
        body.classList.remove("small", "medium", "large"); // Remove any existing size classes
        body.classList.add(size); // Add the selected size class
    }
</script>


<script>
    /*--Search function--start(27/11/24)*/
    const searchFun = () => {
        let filter = document.getElementById('myInput').value.toUpperCase();
        let circularTable = document.getElementById('circularTable');

        let tr = circularTable.getElementsByTagName('tr');

        for (var i = 0; i < tr.length; i++) {
            let td = tr[i].getElementsByTagName('td')[0];

            if (td) {
                let textvalue = td.textContent || td.innerHTML;

                if (textvalue.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";

                } else {
                    tr[i].style.display = "none";
                }
            }
        }


    }

    /*--Search function--end*/
</script>


<script>
    const counters = document.querySelectorAll('.counter');
    const speed = 500; // The lower the slower

    counters.forEach(counter => {
        const updateCount = () => {
            const target = +counter.getAttribute('data-target');
            const count = +counter.innerText;

            // Lower inc to slow and higher to slow
            const inc = target / speed;

            // console.log(inc);
            // console.log(count);

            // Check if target is reached
            if (count < target) {
                // Add inc to count and output in counter
                counter.innerText = count + inc;
                // Call function every ms
                setTimeout(updateCount, 1);
            } else {
                counter.innerText = target;
            }
        };

        updateCount();
    });
</script>

