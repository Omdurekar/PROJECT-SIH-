<script>
    $(document).ready(function () {
        //loadContent("#WhellView", '/Home/GetWheel', "#loaderWheel", "Error loading content.");
       // loadContent("#MediaView", '/Home/GetMedia', "#loaderMedia", "Error loading content.");
        loadContent("#HighlyValueProjectView", '/Home/GetHighlyValue', "#loaderHighlyValue", "Error loading content.");
       // loadContent("#RssFeedView", '/Home/GetRssFeed', "#loaderRssFeed", "Error loading news content.");
       // loadContent("#SocialMediaView", '/Home/GetSocialMedia', "#loaderSocialMedia", "Error loading social media content.");
        ////loadContent("#StateView", '/Home/GetStateView', "#loaderState", "Error loading content.");
    });

    function loadContent(target, url, loader, errorMsg) {
        $(target).load(url, function (response, status) {
            if (status === "success") {
                $(target).show();
                $(loader).hide();
            } else {
                $(target).html("<p>" + errorMsg + "</p>");
                $(loader).hide();
            }
        });
    }
</script>
