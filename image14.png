        .sectordetails .sectorlist a {
            display: block;
            width: 320px;
            max-width: 100%;
            margin: 20px 0px;
            color: #000;
            text-decoration: none;
            border-radius: 0px 10px 10px 0px;
            padding: 13px 20px;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0px 3px 4px rgba(0, 0, 0, 0.4);
            background: #fff;
        }

            .sectordetails .sectorlist a:hover {
                background: #eeac1b;
                color: #fff;
                font-weight: 600;
            }

            .sectordetails .sectorlist a.active {
                background: #eeac1b;
                color: #fff;
                font-weight: 600;
                width: 350px;
                border-radius: 0px 16px 16px 0px; /*box-shadow: inset 0px 4px 4px rgb(255 255 255 / 40%);*/
            }

    .wheelproject {
    }

    .download-icons img.download-icon {
        width: 37px;
        height: 37px;
        cursor: pointer;
        /*filter: brightness(0) invert(1);*/ /* Makes dark icons white on blue background */
        transition: transform 0.2s;
    }

        .download-icons img.download-icon:hover {
            transform: scale(1.1);
        }

