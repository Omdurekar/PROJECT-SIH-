<style type="text/css">

    /* Tab wheel css start */
    .wheelalternative {
        background: url(../Content/img/wheel-alternative-bg.svg) left bottom no-repeat;
        background-size: cover;
        padding: 43px 0px;
    }

    .container-fluid {
        max-width: 1800px !important;
        width: 100%;
    }

    .tablistwheel {
        text-align: center;
        position: absolute;
        left: 0px;
        top: 50%;
        margin-top: -222px;
        width: 350px;
    }

        .tablistwheel button {
        }

            .tablistwheel button#prev01, .tablistwheel button#next01 {
                border: 0;
                background: transparent;
                border-radius: 4px;
                width: 100%;
            }

                .tablistwheel button#prev01 img, .tablistwheel button#next01 img {
                    width: 30px;
                    height: 16px;
                }

    .ministriesdetails {
        height: 343px;
        overflow-y: hidden;
        scrollbar-width: none;
        scroll-behavior: smooth;
        margin-left: 10px;
    }

        .ministriesdetails .ministrieslist {
            padding-right: 24px;
        }

    .ministrieslist .ministries-inner {
        transition: transform 0.5s ease;
        will-change: transform;
    }

    .ministriesdetails::-webkit-scrollbar {
        display: none;
    }

    .ministriesdetails {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

        .ministriesdetails .ministrieslist a.active {
            position: relative;
        }

            .ministriesdetails .ministrieslist a.active:after {
                content: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><circle cx='256' cy='256' r='256' fill='%23eeac1b'/><path d='M201 384c-6.1 0-12.2-2.3-16.9-7-9.4-9.4-9.4-24.6 0-33.9L271.1 256l-87-87c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l104 104c9.4 9.4 9.4 24.6 0 33.9l-104 104c-4.7 4.7-10.9 7-17 7z' fill='%23ffffff'/></svg>");
                display: inline-block;
                width: 50px;
                height: 48px;
                display: inline-block;
                position: absolute;
                top: -0.5px;
                right: -14px;
            }

        .ministriesdetails .ministrieslist a {
            display: block;
            width: 320px;
            max-width: 100%;
            margin: 20px 0px;
            color: #000;
            text-decoration: none;
            border-radius: 0px 10px 10px 0px;
            padding: 13px 20px;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0px 3px 4px rgba(0, 0, 0, 0.4);
            background: #fff;
        }

            .ministriesdetails .ministrieslist a:hover {
                background: #eeac1b;
                color: #fff;
                font-weight: 600;
            }

            .ministriesdetails .ministrieslist a.active {
                background: #eeac1b;
                color: #fff;
                font-weight: 600;
                width: 350px;
                border-radius: 0px 16px 16px 0px; /*box-shadow: inset 0px 4px 4px rgb(255 255 255 / 40%);*/
            }

    .wheelproject {
    }

    /* Up/Down scroll arrows as CSS chevrons (png fallback hidden) */
    .tablistwheel button#prev01,
    .tablistwheel button#next01,
    .tablistwheelsector button#prev001,
    .tablistwheelsector button#next001 {
        border: 0;
        background: transparent;
        width: 100%;
        line-height: 1;
        cursor: pointer;
    }

        .tablistwheel button#prev01 img,
        .tablistwheel button#next01 img,
        .tablistwheelsector button#prev001 img,
        .tablistwheelsector button#next001 img {
            display: none !important;
        }

        .tablistwheel button#prev01::before,
        .tablistwheel button#next01::before,
        .tablistwheelsector button#prev001::before,
        .tablistwheelsector button#next001::before {
            content: "";
            display: inline-block;
            width: 14px;
            height: 14px;
            border-right: 3px solid #0a154d;
            border-bottom: 3px solid #0a154d;
        }

        /* up chevron */
        .tablistwheel button#prev01::before,
        .tablistwheelsector button#prev001::before {
            transform: rotate(-135deg);
            margin-top: 6px;
        }

        /* down chevron */
        .tablistwheel button#next01::before,
        .tablistwheelsector button#next001::before {
            transform: rotate(45deg);
            margin-bottom: 6px;
        }

    /* Content area inset past the absolute ministry buttons on the left */
    .wheel-content-col {
        padding-left: 340px;
        padding-right: 10px;
    }

    /* Card sits in the gap (buttons -> right edge), centered, not stretched */
    .wheel-center-card {
        max-width: 1050px;
        margin: 0 auto;
    }

    @media (max-width: 1500px) {
        .wheel-content-col {
            padding-left: 290px;
        }

        .wheel-center-card {
            max-width: 920px;
        }
    }

    @media (max-width: 1199px) {
        .wheel-content-col {
            padding-left: 12px;
        }

        .wheel-center-card {
            max-width: 100%;
        }
    }
</style>

