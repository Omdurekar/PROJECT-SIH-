<script>
    //function numberWithCommas(x) {
    //    var num = x.toString();
    //    var lastThree = num.substring(num.length - 3);
    //    var otherNumbers = num.substring(0, num.length - 3);

    //    if (otherNumbers != '') {
    //        lastThree = ',' + lastThree;
    //    }

    //    var result = otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + lastThree;
    //    return result;
    //}
    function numberWithCommas(x) {
        // Round to 2 decimals
        x = parseFloat(x).toFixed(2);

        var parts = x.split(".");
        var num = parts[0]; // integer part
        var decimalPart = parts[1] === "00" ? "" : "." + parts[1]; // show decimals only if not .00

        var lastThree = num.substring(num.length - 3);
        var otherNumbers = num.substring(0, num.length - 3);

        if (otherNumbers !== '') {
            lastThree = ',' + lastThree;
        }

        var formattedInt = otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + lastThree;
        return formattedInt + decimalPart;
    }

    $('h5.count.counter').each(function () {
        var v_pound = $(this).html();
        v_pound = numberWithCommas(v_pound);

        $(this).html(v_pound)
    });
</script>
