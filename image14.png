                                let rowData = [];
                                for (let c = 0; c < table.rows[r].cells.length; c++) {
                                    rowData.push(table.rows[r].cells[c].innerText.trim());
                                }
                                tableData.push(rowData);
                            }

                            // Add table data starting at row 3 (index 2)
                            XLSX.utils.sheet_add_aoa(ws, tableData, { origin: "A3" });

