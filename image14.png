        $(document).ready(function () {
            // Function to switch images based on mode



            function switchImages(mode) {
                //alert(mode)


                $('img').each(function () {

                    const darkSrc = $(this).data('dark');
                    const lightSrc = $(this).data('light');
                    if (mode === 'dark') {
                        $(this).attr('src', darkSrc);
                        // alert('mk');
                    } else {
                        $(this).attr('src', lightSrc);
                    }
                });
            }

            // Check sessionStorage for theme preference on page load
            const theme = sessionStorage.getItem('theme');
            const themeSetTime = sessionStorage.getItem('themeSetTime');
            const currentTime = new Date().getTime();

            // Check if the theme is set and if it's within the last 24 hours
            if (theme === 'dark' && themeSetTime && (currentTime - themeSetTime < 24 * 60 * 60 * 1000)) {

                $('body').addClass('dark-mode');
                $('#darktheme').removeClass('darkbtn').html('<i class="fa fa-sun-o"></i>');
                switchImages('dark'); // Update images for dark mode
                //alert('mmm')
                //updateProjectImages();

            } else {
                switchImages('light'); // Update images for light mode
                //updateProjectImages();
            }

            // Handle button click
            $('#darktheme').on('click', function () {
                if ($('body').hasClass('dark-mode')) {
                    ;
                    // Disable dark mode
                    $('body').removeClass('dark-mode');
                    $(this).addClass('darkbtn').html('<i class="fa fa-moon-o"></i>');
                    sessionStorage.setItem('theme', 'light'); // Save preference
                    sessionStorage.setItem('themeSetTime', new Date().getTime()); // Update timestamp
                    switchImages('light'); // Switch to light mode images
                } else {
                    // Enable dark mode
                    $('body').addClass('dark-mode');
                    $(this).removeClass('darkbtn').html('<i class="fa fa-sun-o"></i>');
                    sessionStorage.setItem('theme', 'dark'); // Save preference
                    sessionStorage.setItem('themeSetTime', new Date().getTime()); // Update timestamp
                    switchImages('dark'); // Switch to dark mode images
                }

                // Refresh the page only once
                if (!sessionStorage.getItem('themeToggled')) {
                    sessionStorage.setItem('themeToggled', 'true');
                    //window.location.reload();  // Refresh the page
                } else {
                    // After page reload, reset the flag in sessionStorage
                    sessionStorage.removeItem('themeToggled');
                }
            });
        });


        $(document).ready(function () {
            $('.slider').slick({
                slidesToShow: 9,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 1500,
                arrows: false,
                dots: false,
                pauseOnHover: false,
                responsive: [{
                    breakpoint: 768,
                    settings: {
                        slidesToShow: 4
                    }
                }, {
                    breakpoint: 520,
                    settings: {
                        slidesToShow: 2.5
                    }
                }]
            });
        });



    </script>

