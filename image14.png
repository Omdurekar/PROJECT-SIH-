                            const table = document.querySelector("#projectNewlyAdded .modal-body table");

                            if (!table || table.rows.length === 0) {
                                alert('No data to download.');
                                return;
                            }

                            let csv = [];

                            // Prepare filters text
                            let filtersTextArr = [];
                            $('#filters .filter-row').each(function () {
                                let field = $(this).find('.field').val();
                                let op = $(this).find('.operator').val();
                                let val = $(this).find('.value').val();

                                if (field && op && val) {
                                    let displayName = fieldDisplayNames[field] || field;
                                    filtersTextArr.push(`${displayName} ${op} ${val}`);
                                }
                            });

                            // Build the title line with filters (if any)
                            let titleLine = "Ministry Wise NewlyAdded Projects";
                            if (filtersTextArr.length > 0) {
                                titleLine += " - " + filtersTextArr.join(', ');
                            }

                            // Add the title + filters line as first row in CSV (quoted)
                            csv.push(`"${titleLine}"`);

                            // Empty row after title line
                            csv.push("");

                            // Now add the table header and rows
                            for (let row of table.rows) {
                                let rowData = [];
                                for (let cell of row.cells) {
                                    let text = cell.innerText.replace(/"/g, '""').trim();
                                    rowData.push(`"${text}"`);
                                }
                                csv.push(rowData.join(","));
                            }

                            const csvContent = csv.join("\n");
                            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                            const url = URL.createObjectURL(blob);

                            const link = document.createElement('a');
                            link.setAttribute('href', url);
                            link.setAttribute('download', 'MinistryWiseNewlyAddedProjects_Report.csv');
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                        });


                        $(document).off("click", "#downloadXLS2").on("click", "#downloadXLS2", function () {
                            const table = document.querySelector("#projectNewlyAdded .modal-body table");
                            if (!table || table.rows.length === 0) {
                                alert('No data to download.');
                                return;
                            }

                            const wb = XLSX.utils.book_new();
                            const ws = XLSX.utils.aoa_to_sheet([]); // empty sheet

                            const columnCount = table.rows[0].cells.length;

                            // Prepare filters text for the header
                            let filtersTextArr = [];
                            $('#filters .filter-row').each(function () {
                                let field = $(this).find('.field').val();
                                let op = $(this).find('.operator').val();
                                let val = $(this).find('.value').val();

                                if (field && op && val) {
                                    let displayName = fieldDisplayNames[field] || field;
                                    filtersTextArr.push(`${displayName} ${op} ${val}`);
                                }
                            });

                            const filtersText = filtersTextArr.length > 0 ? ` - ${filtersTextArr.join(', ')}` : "";
                            const fullTitle = `Ministry Wise NewlyAdded Projects ${filtersText}`;

                            // Add the combined title + filters as first row (A1)
                            XLSX.utils.sheet_add_aoa(ws, [[fullTitle]], { origin: "A1" });

                            // Merge title cell across all columns
                            ws['!merges'] = ws['!merges'] || [];
                            ws['!merges'].push({
                                s: { r: 0, c: 0 },
                                e: { r: 0, c: columnCount - 1 }
                            });

                            // Style the title cell (bold, white text, blue background, centered)
                            const titleCell = XLSX.utils.encode_cell({ r: 0, c: 0 });
                            if (!ws[titleCell]) ws[titleCell] = { t: 's', v: fullTitle };
                            ws[titleCell].s = {
                                font: { bold: true, sz: 14, color: { rgb: "FFFFFF" } },
                                alignment: { horizontal: "center", vertical: "center", wrapText: true },
                                fill: { fgColor: { rgb: "4F81BD" } }
                            };

                            // Add an empty row after title (row 2 / index 1)
                            XLSX.utils.sheet_add_aoa(ws, [[]], { origin: "A2" });

                            // Prepare table data (headers + rows)
                            let tableData = [];
                            for (let r = 0; r < table.rows.length; r++) {
                                let rowData = [];
                                for (let c = 0; c < table.rows[r].cells.length; c++) {
                                    rowData.push(table.rows[r].cells[c].innerText.trim());
                                }
                                tableData.push(rowData);
                            }

                            // Add table data starting at row 3 (index 2)
                            XLSX.utils.sheet_add_aoa(ws, tableData, { origin: "A3" });

                            XLSX.utils.book_append_sheet(wb, ws, "Sheet1");
                            XLSX.writeFile(wb, "MinistryWiseNewlyAddedProjects_Report.xlsx");
                        });
                        $("#projectNewlyAdded").modal("show");
                        $("#projectNewlyAdded1").modal('hide');
                    },
                    //error: function (xhr, status, error) {
                    //    console.error("Error fetching data:", xhr.responseText);
                    //    alert("Error fetching data: " + error);
                    //}
                    error: function () {
                        alert("Error fetching data.");
                    }
                });
            }
            //else {
            //    $("#projectNewlyAdded .modal-body table tbody").empty();
            //    var row = "<tr>" +
            //        "<td colspan='9' style='text-align: center;'>No data available</td>" +
            //        "</tr>";
            //    $("#projectNewlyAdded .modal-body table tbody").append(row);
            //    $("#projectNewlyAdded").modal("show");
            //}
        });



    });

</script>




<script type="text/javascript">
    $(document).ready(function () {
    loadMinistries();
    function loadMinistries() {
    $.ajax({
        url: '/Home/GetMinistries',
        type: 'GET',
        dataType: 'json',
        success: function (data) {
            var $ministriesList = $('#ministriesList');
            $ministriesList.empty();

            // Don't add 'active' class here, just create all links
            data.forEach(function (ministries) {
                $('<a>', {
                    href: 'javascript:void(0)',
                    text: ministries.PROJ_MINISTRY_NAME,
                    // NO class assigned here
                    'data-id': ministries.PROJ_MINISTRY_ID,
                    'data-img': ministries.MMImage
                }).appendTo($ministriesList);
            });

            initSlider();

            // Now, find the first ministry with ACTIVE_FLAG true
            var firstActiveMinistryId = null;
            for (var i = 0; i < data.length; i++) {
                if (data[i].ACTIVE_FLAG) {
                    firstActiveMinistryId = data[i].PROJ_MINISTRY_ID;
                    break;
                }
            }

            // If none marked active, fallback to first ministry
            if (!firstActiveMinistryId && data.length > 0) {
                firstActiveMinistryId = data[0].PROJ_MINISTRY_ID;
            }

            // Remove active from all links just in case
            $ministriesList.find('a').removeClass('active');

            // Add active class only to the ministry link that matches firstActiveMinistryId
            var $activeLink = $ministriesList.find('a').filter(function() {
                return $(this).data('id') === firstActiveMinistryId;
            });

            if ($activeLink.length) {
                $activeLink.addClass('active');
                loadministriesDetail($activeLink.data('id'), $activeLink.data('img'));
            }
        }
    });
}

    

    function initSlider() {
        var $links = $('#ministriesList a');
        var currentIndex = $links.index($('#ministriesList a.active'));
        var totalItems = $links.length;
        var timer;

        function updateActive(index) {
            currentIndex = (index + totalItems) % totalItems;
            $links.removeClass('active');
            var $current = $links.eq(currentIndex).addClass('active');
            loadministriesDetail($current.data('id'), $current.data('img'));


            console.log($current.data('id'));
            scrollToView($current);
            resetTimer();
        }

        function scrollToView($el) {
            var $container = $('.ministriesdetails');
            $container.animate({
                scrollTop: $el.position().top + $container.scrollTop() - $container.height() / 2 + $el.outerHeight() / 2
            }, 1000);
        }

        function resetTimer() {
            clearInterval(timer);
            timer = setInterval(function () {
                updateActive(currentIndex + 1);
            }, 8000);
        }

        $('#prev01').off('click').on('click', function () {
            updateActive(currentIndex - 1);
        });

        $('#next01').off('click').on('click', function () {
            updateActive(currentIndex + 1);
        });

        $('#ministriesList').off('click', 'a').on('click', 'a', function () {
            updateActive($links.index(this));
        });

        resetTimer();
    }

        function loadministriesDetail(id, imgSrc) {
            document.getElementById("ActiveMinistryId").value = id;
        $.ajax({
            url: '/Home/GetWheelData',
            type: 'GET',
            dataType: 'json',
            data: { ministriesId: id },  // **Important**: sending parameter here
            success: function (resp) {

                if (!resp.success || !resp.ministrieswisedata.MinistryWiseDetailList) {
                    $('#ministriesContent').html(`<div class="alert alert-warning">${resp.message || 'No data available.'}</div>`);
                    return;
                }

                var data = resp.ministrieswisedata.MinistryWiseDetailList[0]; // We get filtered single item
                if (!data) {
                    // $('#ministriesContent').html(`<div class="alert alert-danger">Ministry ID ${id} not found.</div>`);
                    $('#ministriesContent').html(`<div class="alert alert-danger">No Ongoing Project found.</div>`);
                    return;
                }

                /*$('#ministriesImage').attr('src', '/Content/img/wheelministry/' + imgSrc);*/
                $('#ministriesContent').html(`
                    <div class="tabcontent01">
                        <div class="row shadow-lg p-3 bg-body rounded wheelbox wheelproject" data-ministries-id="${id}">
                            <h4 class="text-center py-3 heading brd-btm crd-bg-clr text-white">${data.PROJ_MINISTRY_NAME} <small style="font-weight: normal;font-size: 0.7em;">(as of ${resp.ministrieswisedata.Freezmonth})</small></h4>
                            <div class="col-xl-4 col-md-12 col-sm-12 d-flex text-center extrapad project-count">
                                <img src="../Content/img/project-count.png" alt="" >
                                <div class="text-center m-0" style="position:relative">
                                    <p class="count-head py-2 d-inline-block">
                                        Project Count <span>(No.)</span>
                                        <div class="tooglelist">
                                            <a href="javascript:void(0);" class="listicon"><img src="../Content/img/info-icon-blue.svg" alt=""></a>
                                            <div class="listhover listbottom"><h6>Number of central sector projects worth Rs. 150 Cr. and above under MoSPI's monitoring.</h6></div>
                                        </div>
                                    </p>
                                    <h5 class="project-count1">
                                        <label id="WheelPC">${data.ProjectCount}</label>
                                    </h5>
                                </div>
                            </div>
                            <div class="col-xl-4 col-md-12 col-sm-12 d-flex text-center extrapad project-count">
                                <img src="../Content/img/orginal-cost.png" alt="" >
                                <div class="text-center m-0" style="position:relative">
                                    <p class="count-head py-2 d-inline-block">
                                        Original Cost <span>(in Cr)</span>
                                        <div class="tooglelist">
                                            <a href="javascript:void(0);" class="listicon"><img src="../Content/img/info-icon-blue.svg" alt=""></a>
                                            <div class="listhover listbottom"><h6>Total project cost approved by the sanction authority at the time of approval.</h6></div>
                                        </div>
                                    </p>
                                    <h5 class="project-count1">
                                        <label id="WheelPC">₹ ${numberWithCommas(data.ProjectCost)}</label>
                                    </h5>
                                </div>
                            </div>
                            <div class="col-xl-4 col-md-12 col-sm-12 d-flex text-center extrapad project-count">
                                <img src="../Content/img/revised-cost.png" alt="" >
                                <div class="text-center m-0" style="position:relative">
                                    <p class="count-head py-2 d-inline-block">
                                        Latest Revised Cost <span>(in Cr)</span>
                                        <div class="tooglelist">
                                            <a href="javascript:void(0);" class="listicon"><img src="../Content/img/info-icon-blue.svg" alt=""></a>
                                            <div class="listhover listbottom"><h6>Latest of all reported revised project cost/(s).</h6></div>
                                        </div>
                                    </p>
                                    <h5 class="project-count1">
                                        <label id="WheelPC">₹ ${numberWithCommas(data.RevisedCost)}</label>
                                    </h5>
                                </div>
                            </div>
                            <div class="col-xl-4 col-md-12 col-sm-12 d-flex text-center extrapad project-count">
                                <img src="../Content/img/expenditure.png" alt="" >
                                <div class="text-center m-0" style="position:relative">
                                    <p class="count-head py-2 d-inline-block">
                                        Expenditure(Cumm.) <span>(in Cr)</span>
                                        <div class="tooglelist">
                                            <a href="javascript:void(0);" class="listicon"><img src="../Content/img/info-icon-blue.svg" alt=""></a>
                                            <div class="listhover listbottom"><h6>Total expenditure incurred from the project sanction date.</h6></div>
                                        </div>
                                    </p>
                                    <h5 class="project-count1">
                                        <label id="WheelPC">₹ ${numberWithCommas(data.Expend)}</label>
                                    </h5>
                                </div>
                            </div>
                            <div class="col-xl-4 col-md-12 col-sm-12 d-flex text-center extrapad Completed_Project">
                                <img src="../Content/img/compliance-year.png" alt="" >
                                <div class="text-center m-0" style="position:relative">
                                    <p class="count-head py-2 d-inline-block">
                                        Completed During Month <span>(No.)</span>
                                        <div class="tooglelist"><a href="javascript:void(0);" class="listicon"><img src="../Content/img/info-icon-blue.svg" alt=""></a>
                                            <div class="listhover listbottom"><h6>Number of projects reported as completed during last month.</h6></div>
                                        </div>
                                    </p>
                                    <h5 class="project-count1">
                                        <label id="WheelCompNo">${data.CompletedProject}</label>
                                    </h5>
                                </div>
                            </div>
                            <div class="col-xl-4 col-md-12 col-sm-12 d-flex text-center extrapad New_Added">
                                <img src="../Content/img/new-project.png" alt="" >
                                <div class="text-center m-0" style="position:relative">
                                    <p class="count-head py-2 d-inline-block">
                                        Newly Added <span>(No.)</span>
                                        <div class="tooglelist"><a href="javascript:void(0);" class="listicon"><img src="../Content/img/info-icon-blue.svg" alt=""></a>
                                            <div class="listhover listbottom"><h6>Number of projects newly onboarded under MoSPI's monitoring during last month.</h6></div>
                                        </div>
                                    </p>
                                    <h5 class="project-count1">
                                        <label id="WheelNewAddNo">${data.NewAddedProject}</label>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>
                `);
            },
            error: function () {
                $('#ministriesContent').html('<div class="alert alert-danger">Error loading data. Please try again later.</div>');
            }
        });
    }
});

// Utility function to format numbers with commas
// function numberWithCommas(x) {
//     if (x == null) return '0';
//     return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    // }

    function numberWithCommas(x) {
    if (x == null || x === '') return '0';

    // Strip commas in case the value was already formatted
    let cleaned = typeof x === 'string' ? x.replace(/,/g, '') : x;

    let num = Number(cleaned);
    if (isNaN(num)) return '0';

    num = num.toFixed(2);
    let parts = num.split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    return parts.join('.');
}


  // 
</script>



<script type="text/javascript">

  $(document).ready(function () {
    loadSectors();

    
    function loadSectors() {
  $.ajax({
    url: '/Home/GetSectors',
    type: 'GET',
    dataType: 'json',
    success: function (data) {
      var $sectorList = $('#sectorList');
      $sectorList.empty();

      // Create all links WITHOUT 'active' class
      data.forEach(function (sector) {
        $('<a>', {
          href: 'javascript:void(0)',
          text: sector.SECTOR_NAME,
          // No active class here
          'data-id': sector.SECTOR_ID,
          'data-img': sector.SMIImage
        }).appendTo($sectorList);
      });

      initSlider(); // initialize slider AFTER data is loaded

      // Find the first sector with ACTIVE_FLAG true
      var firstActiveSectorId = null;
      for (var i = 0; i < data.length; i++) {
        if (data[i].ACTIVE_FLAG) {
          firstActiveSectorId = data[i].SECTOR_ID;
          break;
        }
      }

      // If no active sector found, fallback to first sector
      if (!firstActiveSectorId && data.length > 0) {
        firstActiveSectorId = data[0].SECTOR_ID;
      }

      // Remove any active class just in case
      $sectorList.find('a').removeClass('active');

      // Add active class only to the correct sector link
      var $activeLink = $sectorList.find('a').filter(function () {
        return $(this).data('id') === firstActiveSectorId;
      });

      if ($activeLink.length) {
        $activeLink.addClass('active');
        $activeLink.trigger('click');
      }
    }
  });
}

