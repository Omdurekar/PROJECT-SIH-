          <h5 class="project-count11"><label id="WheelPC1_RevisedCost">₹ ${numberWithCommas(data.RevisedCost)}</label></h5>
        </div>
      </div>

      <div class="col-xl-4 col-md-12 col-sm-12 d-flex text-center extrapad project-count11">
        <img src="../Content/img/expenditure.png" alt="">
