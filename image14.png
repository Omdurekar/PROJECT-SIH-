:"July, 2026","ProjectCount":75,"ProjectCost":202755.04,"Expend":111438.38,"RevisedCost":156938.14,"NewAddedProject":1,"CompletedProject":0},{"StateId":22,"StateName":"Tripura","Freezmonth":"July, 2026","ProjectCount":17,"ProjectCost":131859.11,"Expend":93385.17,"RevisedCost":74046.8,"NewAddedProject":2,"CompletedProject":0},{"StateId":37,"StateName":"Uttar Pradesh","Freezmonth":"July, 2026","ProjectCount":168,"ProjectCost":536436.18,"Expend":342271.33,"RevisedCost":548156.03,"NewAddedProject":4,"CompletedProject":0},{"StateId":23,"StateName":"Uttarakhand","Freezmonth":"July, 2026","ProjectCount":52,"ProjectCost":146179.29,"Expend":103701.12,"RevisedCost":96740.21,"NewAddedProject":2,"CompletedProject":0},{"StateId":36,"StateName":"West Bengal","Freezmonth":"July, 2026","ProjectCount":78,"ProjectCost":232645.9,"Expend":141576.32,"RevisedCost":184454.21,"NewAddedProject":4,"CompletedProject":0},{"StateId":0,"StateName":"All State Details","Freezmonth":"July, 2026","ProjectCount":1775,"ProjectCost":3370138.22,"Expend":1926099.57,"RevisedCost":3710641.55,"NewAddedProject":0,"CompletedProject":3}];//[];
    var map, indiaLayer, renderer;
    fetchStateData('');
        
        //  GetStateData();

        function fetchStateData(regionName) {
            var statename = document.getElementById("statename");
            var FreezeDate = document.getElementById("FreezeDate");
            var StatePC = document.getElementById("StatePC");
            var StateOC = document.getElementById("StateOC");
            var StateRC = document.getElementById("StateRC");
            var StateEx = document.getElementById("StateEx");
            var StateComp = document.getElementById("StateComp");
            var StateNewAdded = document.getElementById("StateNewAdded");

            var StateDetails = [];

            if (regionName === '') {
                StateDetails = StateData.find(row => row.StateId == 0);
            } else if (regionName.toUpperCase() === 'JAMMU & KASHMIR') {
                StateDetails = StateData.find(row => row.StateName.toUpperCase() === "JAMMU AND KASHMIR");
            } else {
                StateDetails = StateData.find(row =>
                    row.StateName.replace(/\s+/g, '').toUpperCase() === regionName.replace(/\s+/g, '').toUpperCase()
                );

            }
            if (StateDetails) {
                statename.innerHTML = StateDetails.StateName;
                FreezeDate.innerHTML = "(as of " + StateDetails.Freezmonth + ")";
                StatePC.innerHTML = StateDetails.ProjectCount;
                StateOC.innerHTML = "₹ " + numberWithCommas(StateDetails.ProjectCost);
                StateRC.innerHTML = "₹ " + numberWithCommas(StateDetails.RevisedCost);
                StateEx.innerHTML = "₹ " + numberWithCommas(StateDetails.Expend);
                StateComp.innerHTML = 0;//StateDetails.CompletedProject;changes after discuss with madam on 26-09-2025
                StateNewAdded.innerHTML = 0;//StateDetails.NewAddedProject;changes after discuss with madam on 26-09-2025
            }
            else {
                statename.innerHTML = "";
                FreezeDate.innerHTML = "";
                StatePC.innerHTML = "0";
                StateOC.innerHTML = "₹ 0";
                StateRC.innerHTML = "₹ 0";
                StateEx.innerHTML = "₹ 0";
                StateComp.innerHTML = "0";
                StateNewAdded.innerHTML = "0";
            }
            updateProjectImages();
        }
       require([

           "esri/map",
           "esri/layers/FeatureLayer",
           "esri/symbols/SimpleFillSymbol",
           "esri/symbols/SimpleLineSymbol",
           "esri/renderers/UniqueValueRenderer",
           "esri/Color",
           "dojo/on",
           "dojo/domReady!"
       ], function (Map, FeatureLayer, SimpleFillSymbol, SimpleLineSymbol, UniqueValueRenderer, Color, on) {

            map = new Map("mapDiv", {
               logo: false,
               showAttribution: false,
               basemap: "topo",
               center: [82.9739, 22.5937],
               zoom: 5,
               slider: false

           });

           map.disablePan();
           map.disableScrollWheel();
           map.disableRubberBandZoom();
           map.disableClickRecenter();
           map.disableShiftDoubleClickZoom();
           map.disableKeyboardNavigation();
           map.hideZoomSlider();
           map.disableMapNavigation();

            indiaLayer = new FeatureLayer(
               "https://mapservice.gov.in/gismapservice/rest/services/BharatMapService/Admin_Boundary_District/MapServer/0",
               { outFields: ["*"] }
           );
           map.addLayer(indiaLayer);

            renderer = new UniqueValueRenderer(
               new SimpleFillSymbol(
                   SimpleFillSymbol.STYLE_SOLID,
                   new SimpleLineSymbol(SimpleLineSymbol.STYLE_SOLID, new Color([0, 0, 0]), 1),
                   new Color([255, 255, 255, 0.1])
               ),
               "STNAME"
           );

            //GetStateData(); // Fetch state data

            indiaLayer.on("update-end", function () {
                //console.log("Vaibhav: Map updated, applying renderer...");
                updateMapRenderer(); // Ensure rendering happens after data is loaded
            });
            function updateMapRenderer() {
                if (!indiaLayer || StateData.length === 0) {
                    //console.log("Vaibhav: StateData not available yet, waiting...");
                    return;
                }

                //console.log("Vaibhav: Applying colors to states...");
                var validStates = StateData.filter(s => s.StateId !== 0);

                if (validStates.length === 0) {
                    //console.warn("Vaibhav: No valid states found! Ensure API is returning correct data.");
                    return;
                }

                var minProjectCount = Math.min(...validStates.map(s => s.ProjectCount));
                var maxProjectCount = Math.max(...validStates.map(s => s.ProjectCount));
                if (minProjectCount === maxProjectCount) maxProjectCount += 1; // Avoid division by zero
                window.maxProjects = maxProjectCount;
           //var colors = [
           //    [219, 226, 255, 0.7], // Light Violet
           //    [92, 125, 255, 0.7],  // Medium Violet
           //    [59, 89, 204, 0.7],   // Dark Violet
           //    [37, 56, 128, 0.7],  // Deep Violet
           //     ];
                var colors = [
                    new Color([255, 255, 204, 0.8]), // Light Yellow (0 projects)
                    new Color([255, 204, 153, 0.8]), // Light Orange
                    new Color([255, 153, 102, 0.8]), // Dark Orange
                    new Color([255, 102, 102, 0.8]), // Red
                    new Color([204, 51, 51, 0.8])    // Dark Red
                ];

                var rangeStep = (maxProjectCount - minProjectCount) / colors.length;

                indiaLayer.graphics.forEach(function (feature) {
                    var stateName = feature.attributes["STNAME"];
                    var stateName1 = feature.attributes["STNAME"];
                    if (stateName1.toUpperCase() === "JAMMU & KASHMIR") {
                        stateName1 = "JAMMU AND KASHMIR";
                    }
                    else if (stateName1.toUpperCase() === "DADRA,NAGAR HAVELI,DAMAN & DIU") {
                        stateName1 = "DADRA & NAGAR HAVELI AND DAMAN & DIU";
                    }

                    // Normalize state name (fix issues like "JAMMU & KASHMIR" vs "JAMMU AND KASHMIR")
                    //var normalizedStateName = stateName.replace("&", "AND").toUpperCase();

                    var stateDetails = validStates.find(s => s.StateName.replace(/\s+/g, '').toUpperCase() === stateName1.replace(/\s+/g, '').toUpperCase());
                    if (!stateDetails) {
                        console.warn("State details not found for ", stateName);
                        return;
                    }

                    let projectCount = stateDetails.ProjectCount;
                    let colorIndex = Math.floor((projectCount - minProjectCount) / rangeStep);
                    if (colorIndex >= colors.length) colorIndex = colors.length - 1;

                   renderer.addValue(stateName, new SimpleFillSymbol(
                       SimpleFillSymbol.STYLE_SOLID,
                       new SimpleLineSymbol(SimpleLineSymbol.STYLE_SOLID, new Color([0, 0, 0]), 1),
                        new Color(colors[colorIndex])
                   ));
               });

               indiaLayer.setRenderer(renderer);
                indiaLayer.redraw();
                createLegend();
            }

           var highlightSymbol = new SimpleFillSymbol(
               SimpleFillSymbol.STYLE_SOLID,
               new SimpleLineSymbol(SimpleLineSymbol.STYLE_SOLID, new Color([0, 0, 0]), 1),
               new Color([10, 21, 77, 0.8])
           );

            on(indiaLayer, "mouse-over", function (evt) {
                let graphic = evt.graphic;
                if (graphic) {
                    graphic.setSymbol(highlightSymbol);
                }

                let regionName = graphic.attributes["STNAME"];
                map.infoWindow.setContent(regionName);
                map.infoWindow.show(evt.screenPoint, map.getInfoWindowAnchor(evt.screenPoint));

                fetchStateData(regionName);
            });

            on(indiaLayer, "mouse-out", function (evt) {
                if (evt.graphic) {
                    evt.graphic.setSymbol(null);
                }
                map.infoWindow.hide();
                indiaLayer.redraw();
            });

           function createLegend() {
               var legendDiv = document.getElementById("legendDiv");

               if (!window.maxProjects || isNaN(window.maxProjects)) {
                   console.warn("maxProjects is not defined yet.");
                   return;
               }

               // Set legend container styles (Transparent Background)
               legendDiv.style.backgroundColor = "rgba(255, 255, 255, 0.8)";
               legendDiv.style.padding = "10px";
               legendDiv.style.borderRadius = "5px";

               // Creating a properly styled vertical legend
               legendDiv.innerHTML = `
        <div style="display: flex; align-items: center; gap: 10px;">
            <!-- Color Bar -->
            <div style="display: flex; flex-direction: column; width: 20px; height: 250px; border: 1px solid black; background: linear-gradient(to top, 
                
                rgb(255, 255, 204),
                rgb(255, 204, 153),
                rgb(255, 153, 102),
                rgb(255, 102, 102),
                rgb(204, 51, 51)
            );">
            </div>

            <!-- Labels -->
            <div style="display: flex; flex-direction: column; justify-content: space-between; height: 250px; font-size: 12px;">
                <span>${window.maxProjects}</span>
                <span>${Math.round((3 * window.maxProjects) / 4)}</span>
                <span>${Math.round(window.maxProjects / 2)}</span>
                <span>${Math.round(window.maxProjects / 4)}</span>
                <span>0</span>
            </div>
        </div>`;
           }






           });

       //});
</script>


</div>

