</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const ministryTab = document.getElementById('ministry-tab');
        const stateTab = document.getElementById('state-tab');

        // Listen for when a tab becomes active
        const tabTriggers = document.querySelectorAll('button[data-bs-toggle="tab"]');
        tabTriggers.forEach(tab => {
            tab.addEventListener('shown.bs.tab', function (event) {
                const activeTabId = event.target.id;

                if (activeTabId === 'ministry-tab') {
                    ministryTab.classList.add('active');
                    stateTab.classList.remove('active');
                } else if (activeTabId === 'state-tab') {
                    stateTab.classList.add('active');
                    ministryTab.classList.remove('active');
                }
            });
        });
    });
</script>
