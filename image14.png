<script>
           // Example of the JSON structure with both light and dark images
           const images = {
               "projectCount": {
                   "dark": "../Content/img/project-count-dark.png",
                   "light": "../Content/img/project-count.png"
               },
               "expenditure": {
                   "dark": "../Content/img/expenditure-dark.png",
                   "light": "../Content/img/expenditure.png"
               },
               "revisedCost": {
                   "dark": "../Content/img/revised-cost-dark.png",
                   "light": "../Content/img/revised-cost.png"
               },
               "originalCost": {
                   "dark": "../Content/img/orginal-cost-dark.png",
                   "light": "../Content/img/orginal-cost.png"
               },
               "newProject": {
                   "dark": "../Content/img/new-project-dark.png",
                   "light": "../Content/img/new-project.png"
               },
               "complianceYear": {
                   "dark": "../Content/img/compliance-year-dark.png",
                   "light": "../Content/img/compliance-year.png"
               }
           };
           // Function to update images based on current theme
           function updateProjectImages() {
               var isDarkMode = document.body.classList.contains('dark-mode');

               //// Update all images dynamically
               $('#blk img').each(function () {
                   var img = $(this);
                   if (img.attr('alt') === 'Project Count') {
                       img.attr('src', isDarkMode ? images.projectCount.dark : images.projectCount.light);
                   } else if (img.attr('alt') === 'Expenditure') {
                       img.attr('src', isDarkMode ? images.expenditure.dark : images.expenditure.light);
                   } else if (img.attr('alt') === 'Latest Revised Cost') {
                       img.attr('src', isDarkMode ? images.revisedCost.dark : images.revisedCost.light);
                   } else if (img.attr('alt') === 'Original Cost') {
                       img.attr('src', isDarkMode ? images.originalCost.dark : images.originalCost.light);
                   } else if (img.attr('alt') === 'Newly Added Project') {
                       img.attr('src', isDarkMode ? images.newProject.dark : images.newProject.light);
                   } else if (img.attr('alt') === 'Compliance Year') {
                       img.attr('src', isDarkMode ? images.complianceYear.dark : images.complianceYear.light);
                   }
               });
           }



