            <div class="row ">
                <div class=" col-sm-12 col-md-12 col-lg-4 text-center ">
                    <h2 class="my-3 whatsnew">What’s New</h2>
                    <div class=" whts-new  p-3 border  shadow-sm whtmedia">
                                <div class="whatsnewlist">
