<section id="about-us-home">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="auh-left">
                    <div class="auh-left-h-s">
                       <div class="line-auhlhs"></div>
                    </div>
                    <div class="auh-left-h">
                        <h2>
                            National e-Governance Division                        </h2>
                    </div>
                    <div class="auh-left-para">
                        <div>
                            <p style="text-align: justify;">In 2009, the National e-Governance Division was created by the Ministry of Electronics &amp; Information Technology as an independent business division under the Digital India Corporation (erstwhile Media Lab Asia), a Section 8 not-for-profit company. Since 2009, NeGD has been playing a pivotal role in supporting MeitY in programme management and implementation of e-Governance projects, providing technical and advisory support to ministries/departments, both at central and state levels, along with other government organisations.</p>
<p style="text-align: justify;"></p>                        </div>
                    </div>
                    <div class="auh-left-link d-flex">
                        <a href="https://negd.gov.in/about-negd">Learn More</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="auh-right">
                    <div class="auh-media-main">
                        <div class="auh-media-circle circle-1"></div>
                        <div class="auh-media-circle circle-2"></div>
                        <div class="auh-media-circle circle-3"></div>
                        <div class="auh-media-circle circle-4"></div>
                        <div class="auh-media-circle circle-5"></div>
                        <div class="auh-media-circle circle-6"></div>
                        <div class="auh-media-circle circle-7"></div>
                        <div class="auh-media-circle circle-8"></div>

                    </div>
                </div>
            </div>


        </div>
    </div>
</section>

 
