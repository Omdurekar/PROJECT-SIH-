<script>
    jQuery(document).on("click", ".htv-r-search img", function() {
        jQuery(".search-form").toggleClass("active");
    });
    
    jQuery(document).on("click", ".trp-language-switcher", function() {
        jQuery(".trp-language-switcher .trp-ls-shortcode-language").toggle();
    });

    jQuery(document).ready(function() {

        var isMobile = window.matchMedia("(max-width: 991px)").matches;

        if (!isMobile) {
            // ── DESKTOP: hover se submenu open, overflow check ──
            jQuery(document).on('mouseenter', '.dropdown-submenu', function() {
                var $submenu = jQuery(this).find('> .dropdown-menu');
                $submenu.css('display', 'block');
                var menuRight = $submenu.offset().left + $submenu.outerWidth();
                var windowWidth = jQuery(window).outerWidth();
                if (menuRight > windowWidth) {
                    $submenu.css({ 'left': 'auto', 'right': '100%' });
                } else {
                    $submenu.css({ 'left': '100%', 'right': 'auto' });
                }
            }).on('mouseleave', '.dropdown-submenu', function() {
                jQuery(this).find('> .dropdown-menu').css('display', '');
            });

        } else {
            // ── MOBILE: click se submenu toggle (accordion style) ──
            jQuery(document).on('click', '.dropdown-submenu > .nav-link', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var $submenu = jQuery(this).siblings('.dropdown-menu');
                // Close other open submenus at same level
                jQuery(this).closest('ul').find('.dropdown-menu.show').not($submenu).removeClass('show');
                $submenu.toggleClass('show');
            });
        }

        // Window resize pe re-check
        jQuery(window).on('resize', function() {
            isMobile = window.matchMedia("(max-width: 991px)").matches;
        });
    });
</script>



