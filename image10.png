<script>
function externalLinks() {
    var links = document.getElementsByTagName("a");

    for (var i = 0; i < links.length; i++) {
        var link = links[i];

        // Skip if no href
        if (!link.getAttribute("href")) {
            continue;
        }

        // Skip if download attribute exists
        if (link.hasAttribute("download")) {
            continue;
        }

        // Add target="_blank" for external links
        if (link.hostname && link.hostname !== location.hostname) {
            link.target = "_blank";
        }
    }
}
externalLinks();

jQuery('a').filter(function() {
    // Exclude the specified URLs
    var excludedHostnames = ["uatnegd.digitalindiacorporation.in"];
    var currentHostname = this.hostname || location.hostname;
    return currentHostname !== location.hostname && excludedHostnames.indexOf(currentHostname) === -1 && !this.hasAttribute("download");
}).not('a[href="https://uatnegd.digitalindiacorporation.in/"]').click(function(e) {
    if (!confirm(
            "You are being redirected to an external website. Please note that NeGD Website cannot be held responsible for external websites' content & privacy policies."
            )) {
        // If the user clicks 'no', then don't proceed to the link.
        e.preventDefault();
    }
});
</script>

<a href="#" class="back-to-top" title="Back to top">&#8679;</a>

<script>
  const backToTop = document.querySelector('.back-to-top');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      backToTop.style.display = 'block';
    } else {
      backToTop.style.display = 'none';
    }
  });

  backToTop.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<script>
(function () {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function init() {
    fixInvalidARIA();
    fixIframes();
    fixYouTubeARIA();
  }

  function fixInvalidARIA() {
    const valid = [
      'aria-label','aria-labelledby','aria-hidden','aria-expanded',
      'aria-pressed','aria-checked','aria-selected',
      'aria-valuenow','aria-valuemin','aria-valuemax',
      'aria-controls','aria-describedby','aria-haspopup'
    ];

    document.querySelectorAll('*').forEach(el => {
      [...el.attributes].forEach(attr => {
        if (attr.name.startsWith('aria-') && !valid.includes(attr.name)) {
          el.removeAttribute(attr.name);
        }
      });
    });
  }

function fixIframes() {
    document.querySelectorAll('iframe').forEach((iframe, i) => {

        // Third-party embeds (Facebook etc.)
        if (iframe.src && iframe.src.includes('facebook.com')) {
            iframe.setAttribute('title', 'Facebook content');
            return;
        }

        if (!iframe.title) {
            iframe.title = 'Embedded content ' + (i + 1);
        }
    });
}

function fixYouTubeARIA() {
    document.querySelectorAll('iframe[src*="youtube.com"]').forEach(iframe => {
        iframe.removeAttribute('aria-label');
        if (!iframe.title) {
            iframe.title = 'YouTube video player';
        }
    });
}
})();
</script>

